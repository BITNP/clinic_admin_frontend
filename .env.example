# Copy to .env and adjust. docker compose loads .env automatically.

# Host port the admin frontend listens on.
ADMIN_FRONTEND_PORT=5173

# Upstream the frontend proxies /api, /login, /logout to.
# Defaults to the host running the backend at :8080 (works when the backend
# runs on the same machine, e.g. `docker compose up` in clinic-backend).
# For a backend on another server, set this to its URL, e.g.
# BACKEND_UPSTREAM=http://api.example.com:8080
BACKEND_UPSTREAM=http://host.docker.internal:8080
